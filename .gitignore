# Local Pi runtime state
.atl/

# Python: la app GNOME se ejecuta desde ~/.local, el bytecode no se versiona
__pycache__/
*.py[cod]

# Estado local del agente (preflight de SDD, caches de sesion)
.pi/

# Any target directory, at any depth. An anchored rule misses a nested one --
# which is how 2 GB of build artifacts almost got pushed from src-tauri/src-tauri.
**/target/
