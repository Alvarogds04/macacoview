#!/usr/bin/env bash
# Launcher for the native GNOME app.
#
# Runs straight from the checkout: the package lives one level up from this
# script, so PYTHONPATH points at gui/. install.sh writes a copy that points at
# ~/.local/lib/pc-ai-monitor instead.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec env PYTHONPATH="$here" python3 -m pc_ai_monitor "$@"
