#!/usr/bin/env python3

import json
import os
import re
import subprocess
from pathlib import Path
import sys


def run(cmd):
    try:
        return subprocess.check_output(
            cmd,
            text=True,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        return ""


def gib(kb):
    return kb / 1024 / 1024


# --------------------------------------------------
# Memoria del sistema
# --------------------------------------------------

meminfo = {}

try:
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1)
            meminfo[key] = int(value.strip().split()[0])
except Exception:
    pass

total_kb = meminfo.get("MemTotal", 0)
avail_kb = meminfo.get("MemAvailable", 0)
used_kb = max(0, total_kb - avail_kb)

swap_total = meminfo.get("SwapTotal", 0)
swap_free = meminfo.get("SwapFree", 0)
swap_used = max(0, swap_total - swap_free)


# --------------------------------------------------
# Procesos
# --------------------------------------------------

ps_output = run([
    "ps",
    "-eo",
    "pid=,ppid=,uid=,rss=,%cpu=,comm=,args="
])

processes = []

for line in ps_output.splitlines():
    try:
        parts = line.strip().split(None, 6)

        if len(parts) < 7:
            continue

        pid = int(parts[0])
        ppid = int(parts[1])
        uid = int(parts[2])
        rss = int(parts[3])
        cpu = float(parts[4])
        comm = parts[5]
        args = parts[6]

        processes.append({
            "pid": pid,
            "ppid": ppid,
            "uid": uid,
            "rss_kb": rss,
            "cpu": cpu,
            "comm": comm,
            "args": args,
        })

    except Exception:
        continue


# --------------------------------------------------
# AMDGPU / GTT
# --------------------------------------------------

gem_data = run([
    "sudo",
    "-n",
    "/usr/local/bin/amdgpu-gem-info-read"
])

gtt_by_pid = {}
vram_by_pid = {}

current_pid = None

for line in gem_data.splitlines():

    m = re.match(r"^pid\s+(\d+)\s+", line)

    if m:
        current_pid = int(m.group(1))
        continue

    if current_pid is None:
        continue

    m = re.search(
        r":\s+(\d+)\s+byte\s+(GTT|VRAM)",
        line
    )

    if not m:
        continue

    size = int(m.group(1))
    kind = m.group(2)

    if kind == "GTT":
        gtt_by_pid[current_pid] = \
            gtt_by_pid.get(current_pid, 0) + size

    elif kind == "VRAM":
        vram_by_pid[current_pid] = \
            vram_by_pid.get(current_pid, 0) + size


# --------------------------------------------------
# Grupos vigilados ([[watch]] del config de la app)
# --------------------------------------------------

# El comportamiento de siempre, tal como estaba hardcodeado: cada patrón es
# una expresión regular buscada sobre el nombre del proceso (comm) y sobre su
# línea completa. "system" (uid 0) y "other" (el resto) son reglas fijas.
WATCH_DEFAULTS = (
    {
        "name": "pi",
        "match": (r"^pi$", r"/\.pi-lens/", r"/\.pi/agent/"),
        "icon": "\U0001f967",
        "visible": True,
    },
    {
        "name": "hermes",
        "match": (r"^hermes$", r"/\.hermes/", "hermes_cli"),
        "icon": "\U0001fab6",
        "visible": True,
    },
    {
        "name": "firefox",
        "match": (r"^firefox$", r"/firefox/"),
        "icon": "\U0001f98a",
        "visible": True,
    },
    {"name": "system", "match": (), "icon": "\u2699\ufe0f", "visible": True},
    {"name": "other", "match": (), "icon": "\U0001f4e6", "visible": True},
)

WATCH_CONFIG = Path.home() / ".config/pc-ai-monitor/config.toml"


def _load_watch():
    """Entradas [[watch]] del config de la app.

    Sin sección (o con TOML roto) valen los defaults, que reproducen el
    comportamiento hardcodeado: un config roto nunca cambia lo que se
    monitorea. Con al menos una entrada válida, el usuario eligió qué
    vigilar y esas reemplazan a todas las de siempre.
    """
    try:
        import tomllib

        raw = tomllib.loads(WATCH_CONFIG.read_text()).get("watch")
    except Exception:
        return [dict(entry) for entry in WATCH_DEFAULTS]

    if not isinstance(raw, list):
        return [dict(entry) for entry in WATCH_DEFAULTS]

    entries = []
    for item in raw:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name") or "").strip().lower()
        if not name:
            continue
        match_raw = item.get("match")
        if match_raw is None:
            match_raw = ()
        if not isinstance(match_raw, list):
            continue
        visible = item.get("visible")
        entries.append({
            "name": name,
            "match": tuple(str(p) for p in match_raw if str(p).strip()),
            "icon": str(item.get("icon") or ""),
            "visible": visible if isinstance(visible, bool) else True,
        })

    return entries or [dict(entry) for entry in WATCH_DEFAULTS]


watch = _load_watch()


def _matches(entry, comm, args):
    """Un patrón alcanza con que aparezca en el nombre o en la línea completa.

    Una regex rota no tira el colector: el patrón se ignora y listo.
    """
    for pattern in entry["match"]:
        try:
            if re.search(pattern, comm) or re.search(pattern, args):
                return True
        except re.error:
            continue
    return False


# Los patrones deciden primero (en el orden del config), después la regla fija
# de root y por último el grupo del resto. Una entrada invisible no se monitorea:
# ni arma grupo ni aparece en la barra.
_pattern_entries = [entry for entry in watch if entry["match"] and entry["visible"]]
_system_entry = next(
    (
        entry
        for entry in watch
        if not entry["match"] and entry["name"] == "system" and entry["visible"]
    ),
    None,
)
_fallback_entry = next(
    (
        entry
        for entry in watch
        if not entry["match"] and entry["name"] != "system" and entry["visible"]
    ),
    None,
)


groups = {
    entry["name"]: {"rss_kb": 0, "cpu": 0, "pids": []}
    for entry in watch
    if entry["visible"]
}

models = []

for p in processes:

    args = p["args"]
    comm = p["comm"]
    pid = p["pid"]

    # Modelos llama.cpp
    if "llama-server" in args:

        alias_match = re.search(r"--alias\s+(\S+)", args)
        model_match = re.search(r"--model\s+(\S+)", args)
        port_match = re.search(r"--port\s+(\d+)", args)

        alias = (
            alias_match.group(1)
            if alias_match
            else f"llama-{pid}"
        )

        model_path = (
            model_match.group(1)
            if model_match
            else ""
        )

        port = (
            int(port_match.group(1))
            if port_match
            else None
        )

        models.append({
            "alias": alias,
            "pid": pid,
            "port": port,
            "model": os.path.basename(model_path),
            "rss_gib": gib(p["rss_kb"]),
            "cpu": p["cpu"],
            "gtt_gib":
                gtt_by_pid.get(pid, 0) / 1024**3,
            "vram_gib":
                vram_by_pid.get(pid, 0) / 1024**3,
        })

        continue

    group = None

    for entry in _pattern_entries:
        if _matches(entry, comm, args):
            group = entry["name"]
            break

    if group is None and _system_entry is not None and p["uid"] == 0:
        group = _system_entry["name"]

    if group is None and _fallback_entry is not None:
        group = _fallback_entry["name"]

    if group is None:
        continue

    groups[group]["rss_kb"] += p["rss_kb"]
    groups[group]["cpu"] += p["cpu"]
    groups[group]["pids"].append(pid)


for value in groups.values():
    value["rss_gib"] = gib(value.pop("rss_kb"))


data = {
    "memory": {
        "total_gib": gib(total_kb),
        "used_gib": gib(used_kb),
        "available_gib": gib(avail_kb),
        "swap_total_gib": gib(swap_total),
        "swap_used_gib": gib(swap_used),
    },
    "models": models,
    "groups": groups,
    "processes": processes,
}


# --------------------------------------------------
# Chip builder
# --------------------------------------------------

BAR_CONFIG = WATCH_CONFIG
BAR_DEFAULTS = {"hide_zero": True, "always_show": [], "only": [], "units": "gb", "models": "separate"}


def _load_bar_config():
    """Preferencias del pill, tomadas del config de la app.

    Sin archivo (o con TOML roto) valen los defaults: un error de configuración
    nunca deja la barra sin datos.
    """
    try:
        import tomllib

        section = (tomllib.loads(BAR_CONFIG.read_text()).get("bar")) or {}
    except Exception:
        return dict(BAR_DEFAULTS)

    always = section.get("always_show") or []
    only = section.get("only") or []
    units = str(section.get("units", "gb")).lower()
    models = str(section.get("models", "separate")).lower()
    return {
        "hide_zero": bool(section.get("hide_zero", True)),
        "always_show": [str(item).lower() for item in always] if isinstance(always, list) else [],
        "only": [str(item).lower() for item in only] if isinstance(only, list) else [],
        "units": units if units in ("gb", "percent") else "gb",
        "models": models if models in ("separate", "combined") else "separate",
    }


def _fmt(value, config, mem_total):
    """GiB con un decimal, o porcentaje de la memoria total de la máquina."""
    if config["units"] == "percent":
        if mem_total <= 0:
            return "0%"
        return f"{value / mem_total * 100:.0f}%"
    return f"{value:.1f}"


def _wanted(key, value, config):
    """Filtro explícito, lista de deseados, y ceros ocultos por defecto."""
    if config["only"] and key not in config["only"]:
        return False
    if config["always_show"] and key in config["always_show"]:
        return True
    if value > 0:
        return True
    return not config["hide_zero"]


def _build_chips(models, groups, memory=None):
    """Return the chip string shared by --bar and --pill.

    Qué se muestra y cómo lo decide `[bar]` del config de la app: ceros ocultos
    por defecto, `always_show`/`only` para acotar, `units` (gb o percent) y
    `models` (un chip por modelo o una métrica sumada).
    """
    config = _load_bar_config()
    mem_total = float((memory or {}).get("total_gib") or 0.0)
    parts = []

    if config["models"] == "combined":
        total = sum(float(m["gtt_gib"]) for m in models)
        if _wanted("modelos", total, config):
            parts.append(f'\U0001f5a5{_fmt(total, config, mem_total)}')
    else:
        for m in models:

            alias = m["alias"].lower()

            if "abito" in alias:
                icon = "\U0001f916"

            elif "personal" in alias:
                icon = "\U0001f9e0"

            else:
                icon = "\U0001f9e9"

            value = float(m["gtt_gib"])

            if _wanted(alias, value, config):
                parts.append(
                    f'{icon}{_fmt(value, config, mem_total)}'
                )

    for entry in watch:

        # Los grupos de regla fija (system, other) no van al pill: así era
        # antes y así queda para quien no configura nada.
        if not entry["match"] or not entry["visible"]:
            continue

        value = float((groups.get(entry["name"]) or {}).get("rss_gib") or 0.0)

        if _wanted(entry["name"], value, config):
            parts.append(
                f'{entry["icon"] or "\U0001f9e9"}{_fmt(value, config, mem_total)}'
            )

    return "  ".join(parts) if parts else "\u2014"


if "--bar" in sys.argv:

    print(_build_chips(models, groups, data.get("memory")))

elif "--pill" in sys.argv:

    chips = _build_chips(models, groups, data.get("memory"))
    mem = data["memory"]
    print(f'{mem["used_gib"]:.1f}|{mem["total_gib"]:.1f}|{chips}')

else:
    print(json.dumps(data))
