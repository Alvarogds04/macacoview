#!/usr/bin/python3
"""Token consumption collector for MacacoView.

Aggregates six independent sources into one JSON document on stdout:

  remote       litellm proxy token counters, read through the local Prometheus
               that already scrapes the proxy. No API key is needed or read
               here.
  local        llama-server (llama.cpp) token counters, read from the /metrics
               endpoint of every running server discovered in /proc.
  pi           token usage recorded in the Pi session transcripts.
  codex_cli    token usage recorded in the Codex CLI rollout transcripts
               (~/.codex/sessions).
  claude_code  token usage recorded in the Claude Code project transcripts
               (~/.claude/projects).
  codex        Codex subscription window usage (percentages, not token
               counts).

Every source is isolated: one failing source is reported as unavailable and the
others still return data, so the caller never loses the whole snapshot.

The transcript sources (pi, codex_cli, claude_code) are the expensive ones
(hundreds of MB, append-only JSONL). They share one incremental reader: a cache
keeps the byte offset already consumed per file, so a poll parses only the
bytes appended since the last one. A file that shrank is re-read from the
start, which covers truncation and rotation. Each parser autodetects its own
schema and a malformed line is skipped, never fatal for the rest of the file.
"""

from __future__ import annotations

import json
import os
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable
from pathlib import Path

PROMETHEUS = "http://127.0.0.1:9090/api/v1/query"
CODEXBAR = os.path.expanduser("~/.local/bin/codexbar")
SESSIONS_DIR = Path.home() / ".pi/agent/sessions"
CODEX_SESSIONS_DIR = Path.home() / ".codex/sessions"
CLAUDE_PROJECTS_DIR = Path.home() / ".claude/projects"
CACHE_DIR = Path.home() / ".cache/macacoview"
PI_CACHE = CACHE_DIR / "pi-sessions.json"
CODEX_CLI_CACHE = CACHE_DIR / "codex-cli-sessions.json"
CLAUDE_CACHE = CACHE_DIR / "claude-code-sessions.json"
CODEX_CACHE = CACHE_DIR / "codex.json"

# Bump whenever the cached shape changes: an older cache is ignored and the
# transcripts are re-read from the start, which self-heals without manual
# cleanup. Version 2 added the per-model counters. The Codex CLI and Claude
# Code caches follow the same contract with their own version numbers.
PI_CACHE_VERSION = 2
CODEX_CLI_CACHE_VERSION = 1
CLAUDE_CACHE_VERSION = 1

HTTP_TIMEOUT = 3.0
CODEX_TIMEOUT = 15.0
CODEX_TTL = 60.0  # seconds; codexbar reaches the network, so cache it

REMOTE_METRICS = {
    "input": "litellm_input_tokens_metric_total",
    "input_cached": "litellm_input_cached_tokens_metric_total",
    "output": "litellm_output_tokens_metric_total",
    "reasoning": "litellm_output_reasoning_tokens_metric_total",
    "total": "litellm_total_tokens_metric_total",
    "spend_usd": "litellm_spend_metric_total",
}

LOCAL_METRICS = {
    "input": "llamacpp:prompt_tokens_total",
    "input_cached": "llamacpp:prompt_tokens_cached_total",
    "output": "llamacpp:tokens_predicted_total",
}

USAGE_COUNTERS = ("input", "output", "cache_read", "cache_write", "reasoning", "total")


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def get_json(url: str, timeout: float) -> object:
    with urllib.request.urlopen(url, timeout=timeout) as response:
        return json.loads(response.read())


def as_int(value: object) -> int:
    try:
        return int(float(value))  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 0


def as_float(value: object) -> float:
    try:
        return float(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 0.0


def empty_usage_sums() -> dict[str, float]:
    sums: dict[str, float] = {name: 0.0 for name in USAGE_COUNTERS}
    sums["cost_usd"] = 0.0
    sums["turns"] = 0.0
    return sums


# ---------------------------------------------------------------------------
# remote — litellm counters via Prometheus
# ---------------------------------------------------------------------------


def prometheus_by_model(metric: str) -> dict[str, float]:
    query = urllib.parse.urlencode({"query": f"sum by (model) ({metric})"})
    payload = get_json(f"{PROMETHEUS}?{query}", HTTP_TIMEOUT)
    result = payload["data"]["result"]  # type: ignore[index]
    return {
        str(entry["metric"].get("model", "?")): as_float(entry["value"][1])
        for entry in result
    }


def collect_remote() -> dict[str, object]:
    per_metric = {key: prometheus_by_model(name) for key, name in REMOTE_METRICS.items()}

    models = []
    for model in sorted(set().union(*(series.keys() for series in per_metric.values()))):
        row = {key: series.get(model, 0.0) for key, series in per_metric.items()}
        if sum(row[key] for key in REMOTE_METRICS if key != "spend_usd") <= 0:
            continue
        models.append(
            {
                "name": model,
                "input": int(row["input"]),
                "input_cached": int(row["input_cached"]),
                "output": int(row["output"]),
                "reasoning": int(row["reasoning"]),
                "total": int(row["total"]),
                "spend_usd": round(row["spend_usd"], 6),
            }
        )

    models.sort(key=lambda row: row["total"], reverse=True)
    return {
        "status": "ok",
        "models": models,
        "total": sum(row["total"] for row in models),
        "spend_usd": round(sum(row["spend_usd"] for row in models), 6),
    }


# ---------------------------------------------------------------------------
# local — llama.cpp servers discovered in /proc
# ---------------------------------------------------------------------------


def running_llama_servers() -> list[tuple[str, int]]:
    servers: list[tuple[str, int]] = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            raw = (entry / "cmdline").read_bytes()
        except OSError:
            continue
        argv = [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]
        if not argv or not argv[0].endswith("llama-server"):
            continue
        port = alias = None
        for index, arg in enumerate(argv):
            if arg == "--port" and index + 1 < len(argv):
                port = as_int(argv[index + 1])
            elif arg.startswith("--port="):
                port = as_int(arg.split("=", 1)[1])
            elif arg == "--alias" and index + 1 < len(argv):
                alias = argv[index + 1]
            elif arg.startswith("--alias="):
                alias = arg.split("=", 1)[1]
        if port and alias:
            servers.append((alias, port))
    return sorted(set(servers))


def collect_local() -> dict[str, object]:
    models = []
    for alias, port in running_llama_servers():
        try:
            body = urllib.request.urlopen(
                f"http://127.0.0.1:{port}/metrics", timeout=HTTP_TIMEOUT
            ).read().decode("utf-8", "replace")
        except (OSError, urllib.error.URLError, TimeoutError):
            # Server without --metrics (HTTP 501) or already gone: skip it.
            continue

        counters = {}
        for line in body.splitlines():
            if not line or line.startswith("#"):
                continue
            name, _, value = line.partition(" ")
            counters[name] = as_float(value)

        if not any(name in counters for name in LOCAL_METRICS.values()):
            continue

        row = {key: as_int(counters.get(name)) for key, name in LOCAL_METRICS.items()}
        models.append(
            {
                "name": alias,
                "port": port,
                "input": row["input"],
                "input_cached": row["input_cached"],
                "output": row["output"],
                "total": row["input"] + row["output"],
            }
        )

    models.sort(key=lambda row: row["total"], reverse=True)
    return {
        "status": "ok",
        "models": models,
        "total": sum(row["total"] for row in models),
    }


# ---------------------------------------------------------------------------
# pi — incremental scan of the session transcripts
# ---------------------------------------------------------------------------


def load_cache(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def store_cache(path: Path, payload: dict) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(payload))
    except OSError:
        pass


def coerce_sums(raw: object) -> dict[str, float]:
    """Rebuild a counter map from cached JSON, tolerating missing keys."""
    source = raw if isinstance(raw, dict) else {}
    return {name: as_float(source.get(name)) for name in empty_usage_sums()}


# A line parser maps one raw JSONL line to the shared counter schema. It
# returns ``(usage, model, provider)``: ``usage`` is None when the line carries
# no token usage; a non-empty ``model`` re-points the model that later usage
# lines are attributed to (Codex announces it in a separate record).
LineParser = Callable[[bytes], tuple[dict[str, float] | None, str, str]]


def accumulate_usage(
    usage: dict[str, float],
    sums: dict[str, float],
    models: dict[str, dict],
    model: str,
    provider: str,
) -> None:
    """Add one turn to the global counters and to its own model's counters.

    ``usage`` arrives already mapped to the shared schema; the model name comes
    from the transcript record itself, so nothing has to be configured or
    guessed here.
    """
    entry = models.get(model)
    if not isinstance(entry, dict):
        entry = {"sums": empty_usage_sums(), "provider": provider}
        models[model] = entry
    if provider:
        entry["provider"] = provider

    for target in (sums, entry["sums"]):
        for counter in empty_usage_sums():
            target[counter] += as_float(usage.get(counter))
        target["turns"] += 1


def scan_transcripts(
    root: Path,
    cache_path: Path,
    cache_version: int,
    pattern: str,
    parse_line: LineParser,
) -> tuple[dict[str, float], dict[str, dict], int]:
    """Incrementally scan JSONL transcripts under ``root``.

    Returns ``(totals, per_model, sessions)`` in the shared counter schema.
    The cache keeps the byte offset already consumed per file, so a poll
    parses only the bytes appended since the last one; a file that shrank is
    re-read from the start, which covers truncation and rotation. A malformed
    line is skipped, never fatal for the rest of the file.
    """
    cache = load_cache(cache_path)
    files: dict[str, dict] = {}
    if isinstance(cache, dict) and cache.get("version") == cache_version:
        stored = cache.get("files")
        files = stored if isinstance(stored, dict) else {}

    totals = empty_usage_sums()
    per_model: dict[str, dict] = {}
    visited: set[str] = set()
    sessions = 0
    for path in sorted(root.rglob(pattern)) if root.is_dir() else []:
        key = str(path)
        try:
            size = path.stat().st_size
        except OSError:
            continue

        visited.add(key)
        seen = files.get(key) if isinstance(files.get(key), dict) else None
        offset = int(seen.get("offset", 0)) if seen else 0
        sums = coerce_sums((seen or {}).get("sums"))
        models = {
            str(name): {
                "sums": coerce_sums(entry.get("sums")),
                "provider": str(entry.get("provider") or ""),
            }
            for name, entry in ((seen or {}).get("models") or {}).items()
            if isinstance(entry, dict)
        }
        if offset > size:  # truncated or rotated: start over
            offset = 0
            sums = empty_usage_sums()
            models = {}

        current_model = "sin-modelo"
        if size > offset:
            with path.open("rb") as handle:
                handle.seek(offset)
                appended = handle.read(size - offset)

            consumed = 0
            for line in appended.split(b"\n")[:-1]:  # keep the trailing partial line
                consumed += len(line) + 1
                try:
                    usage, model, provider = parse_line(line)
                except Exception:  # noqa: BLE001 — one bad line never stops the scan
                    continue
                if model:
                    current_model = model
                if not usage:
                    continue
                accumulate_usage(usage, sums, models, current_model, provider)

            offset += consumed

        files[key] = {"offset": offset, "sums": sums, "models": models}
        if sums["turns"] > 0:
            sessions += 1
        for name in empty_usage_sums():
            totals[name] += sums[name]

        for name, entry in models.items():
            acc = per_model.setdefault(
                name, {"sums": empty_usage_sums(), "provider": ""}
            )
            for counter in empty_usage_sums():
                acc["sums"][counter] += as_float(entry["sums"].get(counter))
            if entry.get("provider"):
                acc["provider"] = entry["provider"]

    # Forget transcripts that no longer exist, so a deleted session stops
    # counting instead of lingering in the cached totals.
    store_cache(
        cache_path,
        {
            "version": cache_version,
            "files": {k: v for k, v in files.items() if k in visited},
        },
    )

    return totals, per_model, sessions


def transcript_payload(
    totals: dict[str, float], per_model: dict[str, dict], sessions: int
) -> dict[str, object]:
    model_rows = [
        {
            "name": name,
            "provider": str(data.get("provider") or ""),
            "input": int(data["sums"]["input"]),
            "output": int(data["sums"]["output"]),
            "cache_read": int(data["sums"]["cache_read"]),
            "cache_write": int(data["sums"]["cache_write"]),
            "reasoning": int(data["sums"]["reasoning"]),
            "total": int(data["sums"]["total"]),
            "cost_usd": round(as_float(data["sums"]["cost_usd"]), 6),
            "turns": int(data["sums"]["turns"]),
        }
        for name, data in per_model.items()
        if data["sums"]["turns"] > 0
    ]
    # Zero-token rows are real and stay: a local model reached through Pi
    # reports turns but no usage counters, so it ranks by turns after the
    # models that do report tokens.
    model_rows.sort(key=lambda row: (row["total"], row["turns"]), reverse=True)

    return {
        "status": "ok",
        "input": int(totals["input"]),
        "output": int(totals["output"]),
        "cache_read": int(totals["cache_read"]),
        "cache_write": int(totals["cache_write"]),
        "reasoning": int(totals["reasoning"]),
        "total": int(totals["total"]),
        "cost_usd": round(totals["cost_usd"], 6),
        "turns": int(totals["turns"]),
        "sessions": sessions,
        "models": model_rows,
    }


# ---------------------------------------------------------------------------
# pi — incremental scan of the session transcripts
# ---------------------------------------------------------------------------


def pi_parse_line(raw: bytes) -> tuple[dict[str, float] | None, str, str]:
    if b'"usage"' not in raw:
        return None, "", ""
    try:
        record = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None, "", ""
    message = record.get("message") or {}
    usage = message.get("usage")
    if not isinstance(usage, dict):
        return None, "", ""
    mapped = {
        "input": as_float(usage.get("input")),
        "output": as_float(usage.get("output")),
        "cache_read": as_float(usage.get("cacheRead")),
        "cache_write": as_float(usage.get("cacheWrite")),
        "reasoning": as_float(usage.get("reasoning")),
        "total": as_float(usage.get("totalTokens")),
        "cost_usd": as_float((usage.get("cost") or {}).get("total")),
    }
    return (
        mapped,
        str(message.get("model") or "sin-modelo"),
        str(message.get("provider") or ""),
    )


def collect_pi() -> dict[str, object]:
    totals, per_model, sessions = scan_transcripts(
        SESSIONS_DIR, PI_CACHE, PI_CACHE_VERSION, "*.jsonl", pi_parse_line
    )
    return transcript_payload(totals, per_model, sessions)


# ---------------------------------------------------------------------------
# codex_cli — incremental scan of the Codex CLI rollout transcripts
# ---------------------------------------------------------------------------


def codex_parse_line(raw: bytes) -> tuple[dict[str, float] | None, str, str]:
    if b'"token_count"' not in raw and b'"turn_context"' not in raw:
        return None, "", ""
    try:
        record = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None, "", ""
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return None, "", ""
    if record.get("type") == "turn_context":
        # The model is announced once per turn, before its token events; the
        # record carries it at the top level, payload.type is null here.
        return None, str(payload.get("model") or ""), ""
    if payload.get("type") != "token_count":
        return None, "", ""
    info = payload.get("info")
    if not isinstance(info, dict):
        return None, "", ""
    # total_token_usage is cumulative per thread and resets to zero when a
    # resumed thread is appended to the same rollout file; last_token_usage is
    # the per-turn delta, so summing it survives both shapes.
    usage = info.get("last_token_usage")
    if not isinstance(usage, dict):
        return None, "", ""
    mapped = {
        "input": as_float(usage.get("input_tokens")),
        "output": as_float(usage.get("output_tokens")),
        "cache_read": as_float(usage.get("cached_input_tokens")),
        "cache_write": as_float(usage.get("cache_write_input_tokens")),
        "reasoning": as_float(usage.get("reasoning_output_tokens")),
        "total": as_float(usage.get("total_tokens")),
        "cost_usd": 0.0,
    }
    return mapped, "", ""


def collect_codex_cli() -> dict[str, object]:
    totals, per_model, sessions = scan_transcripts(
        CODEX_SESSIONS_DIR,
        CODEX_CLI_CACHE,
        CODEX_CLI_CACHE_VERSION,
        "rollout-*.jsonl",
        codex_parse_line,
    )
    return transcript_payload(totals, per_model, sessions)


# ---------------------------------------------------------------------------
# claude_code — incremental scan of the Claude Code project transcripts
# ---------------------------------------------------------------------------


def claude_parse_line(raw: bytes) -> tuple[dict[str, float] | None, str, str]:
    if b'"usage"' not in raw:
        return None, "", ""
    try:
        record = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None, "", ""
    message = record.get("message")
    if not isinstance(message, dict):
        return None, "", ""
    usage = message.get("usage")
    # Schema autodetection: Claude Code writes snake_case keys and the Pi
    # transcripts camelCase, so one never claims the other's records.
    if not isinstance(usage, dict) or not (
        "input_tokens" in usage or "output_tokens" in usage
    ):
        return None, "", ""
    input_tokens = as_float(usage.get("input_tokens"))
    cache_read = as_float(usage.get("cache_read_input_tokens"))
    cache_write = as_float(usage.get("cache_creation_input_tokens"))
    output = as_float(usage.get("output_tokens"))
    details = usage.get("output_tokens_details")
    mapped = {
        "input": input_tokens,
        "output": output,
        "cache_read": cache_read,
        "cache_write": cache_write,
        "reasoning": (
            as_float(details.get("thinking_tokens"))
            if isinstance(details, dict)
            else 0.0
        ),
        # The API reports no total: it is the sum of every billed component.
        "total": input_tokens + cache_read + cache_write + output,
        "cost_usd": 0.0,
    }
    return mapped, str(message.get("model") or "sin-modelo"), ""


def collect_claude_code() -> dict[str, object]:
    totals, per_model, sessions = scan_transcripts(
        CLAUDE_PROJECTS_DIR,
        CLAUDE_CACHE,
        CLAUDE_CACHE_VERSION,
        "*.jsonl",
        claude_parse_line,
    )
    return transcript_payload(totals, per_model, sessions)


# ---------------------------------------------------------------------------
# codex — subscription window usage
# ---------------------------------------------------------------------------


def window_label(minutes: int) -> str:
    if minutes <= 0:
        return "ventana"
    if minutes >= 7 * 24 * 60:
        return "semanal"
    if minutes % 60 == 0:
        return f"{minutes // 60} h"
    return f"{minutes} min"


def collect_codex() -> dict[str, object]:
    cached = load_cache(CODEX_CACHE)
    if isinstance(cached, dict) and time.time() - as_float(cached.get("fetched_at")) < CODEX_TTL:
        return cached["payload"]  # type: ignore[return-value]

    payload: dict[str, object]
    try:
        completed = subprocess.run(
            [CODEXBAR, "--provider", "codex", "--source", "auto", "--format", "json"],
            capture_output=True,
            text=True,
            timeout=CODEX_TIMEOUT,
            check=False,
        )
        if completed.returncode != 0:
            raise RuntimeError(f"codexbar exited with {completed.returncode}")

        entry = json.loads(completed.stdout)[0]
        usage = entry.get("usage") or {}
        identity = usage.get("identity") or {}

        windows = []
        for slot, label in (("primary", "sesión"), ("secondary", "semanal")):
            window = usage.get(slot)
            if not isinstance(window, dict):
                continue
            windows.append(
                {
                    "label": label,
                    "used_percent": round(as_float(window.get("usedPercent")), 1),
                    "window_minutes": as_int(window.get("windowMinutes")),
                    "resets_at": str(window.get("resetsAt") or ""),
                }
            )

        payload = {
            "status": "ok",
            "plan": str(identity.get("loginMethod") or ""),
            "windows": windows,
        }
    except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
        payload = {"status": "unavailable", "error": exc.__class__.__name__, "windows": []}

    store_cache(CODEX_CACHE, {"fetched_at": time.time(), "payload": payload})
    return payload


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def source(name: str, collector) -> dict[str, object]:
    try:
        return collector()
    except Exception as exc:  # noqa: BLE001 — one bad source must not hide the rest
        return {"status": "unavailable", "error": f"{name}: {exc.__class__.__name__}"}


def main() -> int:
    document = {
        "remote": source("remote", collect_remote),
        "local": source("local", collect_local),
        "pi": source("pi", collect_pi),
        "codex_cli": source("codex_cli", collect_codex_cli),
        "claude_code": source("claude_code", collect_claude_code),
        "codex": source("codex", collect_codex),
    }
    print(json.dumps(document, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
